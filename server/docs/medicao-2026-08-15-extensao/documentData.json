                                                                  "end":  368,
                                                                  "exact":  true
                                                              }
                                               },
                                               {
                                                   "quote":  "Tentando autenticar. O endpoint de token que está no PDF deles não existe mais. Tem um novo, com outro formato de payload, e ninguém avisou.",
